{
  "builds": [
    {
      "src": "bentely_boldtrader/vercel_settings.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "bentely_boldtrader/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "bentely_boldtrader.settings"
  }
}
